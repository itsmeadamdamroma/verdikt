# Cloudflare Workers AI (default). Get a token: dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_token_with_workers_ai_read

# Optional: any OpenAI-compatible endpoint instead of Cloudflare
# CF_BASE_URL=https://api.openai.com/v1

# Public URL of this instance (used in checkout redirects)
VERDIKT_URL=http://localhost:8400
VERDIKT_PORT=8400

# Storage (defaults next to the code)
# VERDIKT_DB=/data/verdikt.db
